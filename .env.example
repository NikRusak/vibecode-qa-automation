# Vibe Coding QA Automation Workshop
# Copy this file to .env and fill in your local values
# DO NOT commit .env to git

# Debug Mode
DEBUG=true
LOG_LEVEL=INFO

# Virtual Environment
VENV_PATH=./venv

# Module 2: Bulk Renamer
RENAMER_INPUT_DIR=./demo_renamer/input
RENAMER_OUTPUT_DIR=./demo_renamer/output
RENAME_DRY_RUN=true

# Module 3: API Diff
API_DIFF_BASELINE=./demo_api_diff/input/baseline.json
API_DIFF_CURRENT=./demo_api_diff/input/current.json
API_DIFF_OUTPUT=./demo_api_diff/output/diff_report.json

# Module 4: CLI Debugging
DEBUG_SCRIPT_PATH=./demo_debugging/broken_image_processor.py
DEBUG_SAMPLE_FILE=./demo_debugging/sample.txt

# Module 5: Anonymizer
ANONYMIZER_INPUT=./hw_anonymizer/input/users.csv
ANONYMIZER_OUTPUT=./hw_anonymizer/output/users_anonymized.csv

# Database (if needed for future modules)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vibecoding_qa
# DB_USER=dev_user
# DB_PASSWORD=dev_password

# Testing
TEST_TIMEOUT=30
TEST_VERBOSE=true
